<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
    <property>
        <name>hadoop.tmp.dir</name>
        <value>{{ data_dir }}/hadoop-temp</value>
    </property>
    <property>
        <name>fs.defaultFS</name>
        <value>hdfs://{{ hostvars[groups['namenode'][0]]['ansible_host'] | default(groups['namenode'][0]) }}:{{ namenode_rpc_port }}</value>
    </property>
    <property>
        <name>io.file.buffer.size</name>
        <value>131072</value>
    </property>
    <property>
        <name>hadoop.http.staticuser.user</name>
        <value>{{ hadoop_user }}</value>
    </property>
    <property>
        <name>hadoop.proxyuser.{{ hadoop_user }}.groups</name>
        <value>*</value>
    </property>
    <property>
        <name>hadoop.proxyuser.{{ hadoop_user }}.hosts</name>
        <value>*</value>
    </property>
</configuration>
